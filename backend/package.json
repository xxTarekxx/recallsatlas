{
  "name": "recallsatlas-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "node -e \"require('./database/mongodb').getDb().then(() => console.log('MongoDB OK')).catch(e => { console.error(e); process.exit(1); })\"",
    "fetch-fda-recalls": "node fdaRecalls/scripts/scrape/scrapeRecalls.js",
    "fetch-fda-recalls:10": "node fdaRecalls/scripts/scrape/scrapeRecalls.js --limit=10",
    "fetch-general-recalls": "node generalRecalls/scripts/fetch/fetchGeneralRecalls.js",
    "fetch-general-recalls:20": "node generalRecalls/scripts/fetch/fetchGeneralRecalls.js --limit=20",
    "fetch-general-recalls:source-only": "node generalRecalls/scripts/fetch/fetchGeneralRecalls.js",
    "reset-generated-recalls": "node scripts/sync/resetGeneratedRecallData.js",
    "restore-fda-backup-seed": "node scripts/sync/restoreFdaBackupSeed.js",
    "restore-fda-seed-images": "node scripts/sync/restoreFdaSeedImages.js",
    "audit:recall-content": "node scripts/audit/recallContentAudit.js",
    "import-recalls-clean": "node scripts/sync/importCleanRecallCollections.js",
    "import-recalls-clean:replace": "node scripts/sync/importCleanRecallCollections.js --replace",
    "recallgraph:normalize": "node recallgraph/src/scripts/normalize-recalls.js",
    "recallgraph:ingest:fda": "node fdaRecalls/scripts/scrape/scrapeRecalls.js",
    "recallgraph:ingest:cpsc": "node generalRecalls/scripts/fetch/fetchGeneralRecalls.js",
    "recallgraph:ingest:raw": "npm run recallgraph:ingest:fda && npm run recallgraph:ingest:cpsc",
    "recallgraph:assert:raw-clean": "node recallgraph/src/scripts/assert-raw-ingest-clean.js",
    "recallgraph:db:up": "docker compose -p recallgraph -f ../docker-compose.recallgraph.yml up -d",
    "recallgraph:db:migrate": "node recallgraph/src/scripts/db-migrate.js",
    "recallgraph:db:status": "node recallgraph/src/scripts/db-status.js",
    "recallgraph:import": "node recallgraph/src/scripts/import-normalized-to-postgres.js",
    "recallgraph:embed": "node recallgraph/src/scripts/generate-embeddings.js",
    "recallgraph:graph": "node recallgraph/src/scripts/build-related-recalls.js",
    "recallgraph:evaluate": "node recallgraph/src/scripts/evaluate-search.js",
    "recallgraph:build-all": "npm run recallgraph:normalize && npm run recallgraph:db:migrate && npm run recallgraph:import && npm run recallgraph:embed && npm run recallgraph:graph && npm run recallgraph:evaluate"
  },
  "dependencies": {
    "axios": "1.15.2",
    "cheerio": "^1.2.0",
    "csv-parse": "^5.6.0",
    "dotenv": "^17.3.1",
    "fs-extra": "^11.3.4",
    "mongodb": "^6.10.0",
    "openai": "^6.35.0",
    "pg": "^8.16.3",
    "playwright": "^1.59.1",
    "puppeteer": "^24.0.0",
    "sharp": "^0.34.5",
    "socks-proxy-agent": "^8.0.5",
    "xlsx": "^0.18.5"
  },
  "description": "",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
