RECALLGRAPH_DATABASE_URL=postgres://recallgraph:CHANGE_ME@127.0.0.1:54329/recallgraph
RECALLGRAPH_DATABASE_SSL=0

# Recommended for production/demo quality.
RECALLGRAPH_EMBEDDING_PROVIDER=openai
RECALLGRAPH_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RECALLGRAPH_EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=optional_for_openai_embeddings

# Wiring/testing only. Mock embeddings verify the pipeline but are not
# semantically meaningful for production search quality.
# RECALLGRAPH_EMBEDDING_PROVIDER=mock
